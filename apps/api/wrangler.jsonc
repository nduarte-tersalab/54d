{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "54d-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Secrets (setear con `wrangler secret put` en prod, .dev.vars en local):
  // SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
  // STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
  // META_PIXEL_ID, META_CAPI_ACCESS_TOKEN,
  // GA4_MEASUREMENT_ID, GA4_API_SECRET
  "vars": {
    // Prod: preview de GitHub Pages (con path /54d). Local se pisa en .dev.vars.
    "SITE_URL": "https://nduarte-tersalab.github.io/54d"
  }
}
