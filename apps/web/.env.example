# Copiar a .env (gitignored) y completar. Pedir los valores reales al equipo.
# Solo las VITE_* llegan al browser: NUNCA pongas un secreto acá.

# API. En local apunta al worker de apps/api; en build de produccion se pasa
# por linea de comandos (ver docs/DEPLOY.md).
VITE_API_URL=http://localhost:8788

# Supabase: clave PUBLICABLE (sb_publishable_...), nunca la secreta.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Medicion. Si quedan vacias, los scripts simplemente no se cargan.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
